  background: rgba(10,26,58,.96);
  color: #fff;
  border-bottom-color: rgba(110,168,255,.32);
  box-shadow: 0 8px 28px rgba(0,0,0,.22);
}
body.dark .site-header .brand h1 { color: #fff; }
body.dark .site-header .brand h1 i { color: #6ea8ff; }
body.dark .site-header .brand span { color: #a9c0ec; }
body.dark .site-header .header-actions .btn-outline {
  color: #fff;
  border-color: rgba(255,255,255,.32);
  background: transparent;
}
body.dark .site-header .header-actions .btn-outline:hover {
  background: rgba(255,255,255,.08);
  border-color: #6ea8ff;
  color: #fff;
}
body.dark .site-header .mobile-menu-toggle {
  color: #fff;
  background: rgba(255,255,255,.06);
  border-color: rgba(255,255,255,.28);
}
body.dark .site-header .mobile-menu-toggle:hover {
  background: rgba(255,255,255,.1);
}

/* Mobile navigation follows the active theme instead of forcing dark UI. */
@media (max-width: 767px) {
  .site-header .mobile-nav-panel,
  .site-header .mobile-nav,
  .site-header .mobile-menu,
  .site-header .navbar-collapse {
    background: #fff;
    color: var(--text);
    border-color: var(--card-border);
  }
  .site-header .mobile-nav a,
  .site-header .mobile-menu a,
  .site-header .navbar-collapse a {
    color: var(--text);
  }
  .site-header .mobile-nav a:hover,
  .site-header .mobile-menu a:hover,
  .site-header .navbar-collapse a:hover {
    background: #f1f5f9;
  }
  body.dark .site-header .mobile-nav-panel,
  body.dark .site-header .mobile-nav,
  body.dark .site-header .mobile-menu,
  body.dark .site-header .navbar-collapse {
    background: #0b1424;
    color: #e6ecf5;
    border-color: #29385a;
  }
  body.dark .site-header .mobile-nav a,
  body.dark .site-header .mobile-menu a,
  body.dark .site-header .navbar-collapse a {
    color: #e6ecf5;
  }
  body.dark .site-header .mobile-nav a:hover,
  body.dark .site-header .mobile-menu a:hover,
  body.dark .site-header .navbar-collapse a:hover {
    background: #17233d;
  }
}


/* ===========================================================
   FINAL THEME RULE: LIGHT HEADER BY DEFAULT
   Dark header is enabled only when the user selects dark mode.
   =========================================================== */
.site-header {
  background: #ffffff;
  color: var(--text);
  border-bottom: 1px solid var(--card-border);
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
}

.site-header .brand h1 {
  color: var(--text);
}

.site-header .brand h1 i {
  color: var(--accent);
}

.site-header .brand span {
  color: var(--text-muted);
}

.site-header .header-actions .btn-outline {
  color: var(--text);
  border-color: var(--card-border);
  background: #ffffff;
}

.site-header .header-actions .btn-outline:hover {
  background: var(--card-bg);
  border-color: var(--accent);
}

.site-header .mobile-menu-toggle {
  color: var(--text);
  border-color: var(--card-border);
  background: #ffffff;
}

body.dark .site-header {
  background: var(--navy-900);
  color: #ffffff;
  border-bottom-color: var(--accent);
  box-shadow: 0 4px 18px rgba(2, 6, 23, 0.25);
}

body.dark .site-header .brand h1 {
  color: #ffffff;
}

body.dark .site-header .brand h1 i {
  color: #6ea8ff;
}

body.dark .site-header .brand span {
  color: #a9c0ec;
}

body.dark .site-header .header-actions .btn-outline,
body.dark .site-header .mobile-menu-toggle {
  color: #ffffff;
  border-color: rgba(255,255,255,.2);
  background: rgba(255,255,255,.04);
}

/* Definitive requested header colour */
html body .site-header,
html body:not(.dark) .site-header,
html:not(.dark) body .site-header {
  background: #333333 !important;
  background-color: #333333 !important;
}
