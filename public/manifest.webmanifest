{
  "id": "/",
  "name": "Manlung Recovery",
  "short_name": "Manlung",
  "description": "Install Manlung Recovery for quick access to digital recovery assistance, secure case tracking, and client support.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#071629",
  "theme_color": "#071629",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "prefer_related_applications": false,
  "version": "1.0.5",
  "shortcuts": [
    {
      "name": "Track a case",
      "short_name": "Track case",
      "description": "Open secure case tracking",
      "url": "/client/track.html",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Request recovery help",
      "short_name": "Request help",
      "description": "Submit a recovery request",
      "url": "/client/request.html",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
