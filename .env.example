SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
ADMIN_USERNAME=replace-with-owner-username
ADMIN_PASSWORD=replace-with-owner-password
MAX_FILE_SIZE=26214400

# Optional services already supported by the project
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
