# Copy these variable names into your Vercel Environment Variables.
# Do NOT commit real credentials here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_CALLBACK_URL=https://YOUR_PRODUCTION_DOMAIN/donate.html
PAYSTACK_CALL_ADMIN_CALLBACK_URL=https://YOUR_PRODUCTION_DOMAIN/
PAYSTACK_WEBHOOK_SECRET=YOUR_PAYSTACK_WEBHOOK_SECRET

# TURN_URL accepts one URL or a comma-separated list. For Metered, use the
# full UDP/TCP/TLS set supplied by Metered's "Show ICE Servers Array".
TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=YOUR_TURN_USERNAME
TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

CALL_RING_TIMEOUT_SECONDS=30
CALL_ACTIVE_TIMEOUT_SECONDS=21600
PUBLIC_APP_URL=https://YOUR_PRODUCTION_DOMAIN
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=Manlung Recovery <noreply@YOUR_DOMAIN>

# Optional production CORS allowlist. Comma-separated full origins.
# Leave empty for same-origin deployments.
ALLOWED_ORIGINS=https://YOUR_PRODUCTION_DOMAIN
