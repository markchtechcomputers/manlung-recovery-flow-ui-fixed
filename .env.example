# Server-side secrets — NEVER commit real values.
NODE_ENV=production
PUBLIC_APP_URL=https://manlungrecovery.manlungshop.co.ke
ALLOWED_ORIGINS=https://manlungrecovery.manlungshop.co.ke
JWT_SECRET=replace-with-a-long-random-secret
