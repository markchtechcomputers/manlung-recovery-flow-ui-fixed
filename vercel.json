{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/config-public.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth-github.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth-google.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai-live.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(terms|donate|donation|blog|knowledge|services|about|contact|careers|trust|faq)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/client/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/css/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://accounts.google.com https://js.paystack.co https://unpkg.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://accounts.google.com; font-src 'self' https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; media-src 'self' https: blob:; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://*.supabase.co https://api.paystack.co https://challenges.cloudflare.com wss: https:; frame-src 'self' https://js.paystack.co https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/verification/([^/]+)/?$",
      "dest": "/public/selfie.html?id=$1",
      "continue": false
    },
    {
      "src": "/api/auth/github(?:/(.*))?",
      "dest": "/api/auth-github.js"
    },
    {
      "src": "^/oauth-callback(?:\\.html)?$",
      "dest": "/public/oauth-callback"
    },
    {
      "src": "/api/auth/google(?:/(.*))?",
      "dest": "/api/auth-google.js"
    },
    {
      "src": "/api/ai-live(?:/(.*))?",
      "dest": "/api/ai-live.js"
    },
    {
      "src": "/api/ai(?:/(.*))?",
      "dest": "/api/ai.js"
    },
    {
      "src": "/api/config/public",
      "dest": "/api/config-public.js"
    },
    {
      "src": "/api/download-apk",
      "dest": "/public/install"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin",
      "dest": "/public/admin/login"
    },
    {
      "src": "^/admin/connect/?$",
      "dest": "/public/admin/connect"
    },
    {
      "src": "^/admin/connect\\.html$",
      "dest": "/public/admin/connect"
    },
    {
      "src": "^/admin/control-center/?$",
      "dest": "/public/admin/control-center"
    },
    {
      "src": "^/admin/control-center\\.html$",
      "dest": "/public/admin/control-center"
    },
    {
      "src": "^/admin/dashboard/?$",
      "dest": "/public/admin/dashboard"
    },
    {
      "src": "^/admin/dashboard\\.html$",
      "dest": "/public/admin/dashboard"
    },
    {
      "src": "^/admin/index/?$",
      "status": 308,
      "headers": {
        "Location": "/admin/dashboard"
      }
    },
    {
      "src": "^/admin/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/admin/dashboard"
      }
    },
    {
      "src": "^/admin/investigation-notes/?$",
      "dest": "/public/admin/investigation-notes"
    },
    {
      "src": "^/admin/investigation-notes\\.html$",
      "dest": "/public/admin/investigation-notes"
    },
    {
      "src": "^/admin/login/?$",
      "dest": "/public/admin/login"
    },
    {
      "src": "^/admin/login\\.html$",
      "dest": "/public/admin/login"
    },
    {
      "src": "^/admin/music-player/?$",
      "dest": "/public/admin/music-player"
    },
    {
      "src": "^/admin/music-player\\.html$",
      "dest": "/public/admin/music-player"
    },
    {
      "src": "^/admin/music/?$",
      "dest": "/public/admin/music"
    },
    {
      "src": "^/admin/music\\.html$",
      "dest": "/public/admin/music"
    },
    {
      "src": "^/admin/operations/?$",
      "dest": "/public/admin/operations"
    },
    {
      "src": "^/admin/operations\\.html$",
      "dest": "/public/admin/operations"
    },
    {
      "src": "^/admin/owner/?$",
      "dest": "/public/admin/owner"
    },
    {
      "src": "^/admin/owner\\.html$",
      "dest": "/public/admin/owner"
    },
    {
      "src": "^/admin/register/?$",
      "dest": "/public/admin/register"
    },
    {
      "src": "^/admin/register\\.html$",
      "dest": "/public/admin/register"
    },
    {
      "src": "^/admin/reset-password/?$",
      "dest": "/public/admin/reset-password"
    },
    {
      "src": "^/admin/reset-password\\.html$",
      "dest": "/public/admin/reset-password"
    },
    {
      "src": "^/admin/reports/?$",
      "dest": "/public/admin/reports"
    },
    {
      "src": "^/admin/reports\\.html$",
      "dest": "/public/admin/reports"
    },
    {
      "src": "^/admin/tools/?$",
      "dest": "/public/admin/tools"
    },
    {
      "src": "^/admin/tools\\.html$",
      "dest": "/public/admin/tools"
    },
    {
      "src": "^/admin/tools/device-recovery/?$",
      "dest": "/public/admin/tools/device-recovery"
    },
    {
      "src": "^/admin/tools/device-recovery\\.html$",
      "dest": "/public/admin/tools/device-recovery"
    },
    {
      "src": "^/admin/tools/link-analysis/?$",
      "dest": "/public/admin/tools/link-analysis"
    },
    {
      "src": "^/admin/tools/link-analysis\\.html$",
      "dest": "/public/admin/tools/link-analysis"
    },
    {
      "src": "^/admin/tools/recovery-evidence/?$",
      "dest": "/public/admin/tools/recovery-evidence"
    },
    {
      "src": "^/admin/tools/recovery-evidence\\.html$",
      "dest": "/public/admin/tools/recovery-evidence"
    },
    {
      "src": "^/admin/tools/remote-desktop/?$",
      "dest": "/public/admin/tools/remote-desktop"
    },
    {
      "src": "^/admin/tools/remote-desktop\\.html$",
      "dest": "/public/admin/tools/remote-desktop"
    },
    {
      "src": "^/admin/tools/security/?$",
      "dest": "/public/admin/tools/security"
    },
    {
      "src": "^/admin/tools/security\\.html$",
      "dest": "/public/admin/tools/security"
    },
    {
      "src": "^/admin/tools/website-scanner/?$",
      "dest": "/public/admin/tools/website-scanner"
    },
    {
      "src": "^/admin/tools/website-scanner\\.html$",
      "dest": "/public/admin/tools/website-scanner"
    },
    {
      "src": "^/admin/((?:[^./]+/)*[^./]+)/?$",
      "dest": "/public/admin/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/public/admin/$1"
    },
    {
      "src": "^/privacy(?:\\.html)?/?$",
      "dest": "/public/privacy"
    },
    {
      "src": "^/client/connect\\.html$",
      "status": 308,
      "headers": {
        "Location": "/client/connect"
      }
    },
    {
      "src": "^/client/connect/?$",
      "dest": "/public/client/connect"
    },
    {
      "src": "^/$",
      "dest": "/public/index"
    },
    {
      "src": "^/manlung-ai/?$",
      "dest": "/public/manlung-ai"
    },
    {
      "src": "^/terms(?:\\.html)?/?$",
      "dest": "/public/terms"
    },
    {
      "src": "^/donate(?:\\.html)?/?$",
      "dest": "/public/donate"
    },
    {
      "src": "^/donation(?:\\.html)?/?$",
      "dest": "/public/donate"
    },
    {
      "src": "^/blog(?:\\.html)?/?$",
      "dest": "/public/blog"
    },
    {
      "src": "^/knowledge(?:\\.html)?/?$",
      "dest": "/public/knowledge"
    },
    {
      "src": "^/services(?:\\.html)?/?$",
      "dest": "/public/services"
    },
    {
      "src": "^/about(?:\\.html)?/?$",
      "dest": "/public/about"
    },
    {
      "src": "^/contact(?:\\.html)?/?$",
      "dest": "/public/contact"
    },
    {
      "src": "^/careers(?:\\.html)?/?$",
      "dest": "/public/careers"
    },
    {
      "src": "^/trust(?:\\.html)?/?$",
      "dest": "/public/trust"
    },
    {
      "src": "^/faq(?:\\.html)?/?$",
      "dest": "/public/faq"
    },
    {
      "src": "^/((?:[^./]+/)*[^./]+)/?$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/public/admin/login"
    },
    {
      "source": "/admin/connect",
      "destination": "/public/admin/connect"
    },
    {
      "source": "/admin/control-center",
      "destination": "/public/admin/control-center"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/public/admin/dashboard"
    },
    {
      "source": "/admin/index",
      "destination": "/public/admin/index"
    },
    {
      "source": "/admin/investigation-notes",
      "destination": "/public/admin/investigation-notes"
    },
    {
      "source": "/admin/login",
      "destination": "/public/admin/login"
    },
    {
      "source": "/admin/music-player",
      "destination": "/public/admin/music-player"
    },
    {
      "source": "/admin/music",
      "destination": "/public/admin/music"
    },
    {
      "source": "/admin/operations",
      "destination": "/public/admin/operations"
    },
    {
      "source": "/admin/owner",
      "destination": "/public/admin/owner"
    },
    {
      "source": "/admin/register",
      "destination": "/public/admin/register"
    },
    {
      "source": "/admin/reset-password",
      "destination": "/public/admin/reset-password"
    },
    {
      "source": "/admin/reports",
      "destination": "/public/admin/reports"
    },
    {
      "source": "/admin/tools",
      "destination": "/public/admin/tools"
    },
    {
      "source": "/admin/tools/device-recovery",
      "destination": "/public/admin/tools/device-recovery"
    },
    {
      "source": "/admin/tools/link-analysis",
      "destination": "/public/admin/tools/link-analysis"
    },
    {
      "source": "/admin/tools/recovery-evidence",
      "destination": "/public/admin/tools/recovery-evidence"
    },
    {
      "source": "/admin/tools/remote-desktop",
      "destination": "/public/admin/tools/remote-desktop"
    },
    {
      "source": "/admin/tools/security",
      "destination": "/public/admin/tools/security"
    },
    {
      "source": "/admin/tools/website-scanner",
      "destination": "/public/admin/tools/website-scanner"
    },
    {
      "source": "/oauth-callback",
      "destination": "/public/oauth-callback"
    },
    {
      "source": "/verification/:token",
      "destination": "/public/selfie?id=:token"
    },
    {
      "source": "/privacy",
      "destination": "/public/privacy"
    },
    {
      "source": "/client/connect",
      "destination": "/public/client/connect"
    },
    {
      "source": "/manlung-ai",
      "destination": "/public/manlung-ai"
    },
    {
      "source": "/",
      "destination": "/public/index"
    },
    {
      "source": "/settings",
      "destination": "/public/settings"
    },
    {
      "source": "/login",
      "destination": "/public/login"
    },
    {
      "source": "/client/dashboard",
      "destination": "/public/client/dashboard"
    },
    {
      "source": "/client/track",
      "destination": "/public/client/track"
    },
    {
      "source": "/client/settings",
      "destination": "/public/client/settings"
    },
    {
      "source": "/client/recovery-center",
      "destination": "/public/client/recovery-center"
    },
    {
      "source": "/client/request",
      "destination": "/public/client/request"
    }
  ]
}
